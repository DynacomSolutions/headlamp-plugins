<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview of the widget for launcher pickers. It uses only views that RemoteViews allows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Cluster" android:textColor="@color/preview_text" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Refresh" android:textColor="@color/preview_accent" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="CPU 42%" android:textColor="@color/preview_text" android:textSize="13sp" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:max="100" android:progress="42"
            android:progressTint="@color/preview_ok" android:progressBackgroundTint="@color/preview_track" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Mem 58%" android:textColor="@color/preview_text" android:textSize="13sp" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:max="100" android:progress="58"
            android:progressTint="@color/preview_ok" android:progressBackgroundTint="@color/preview_track" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="worker-1" android:textColor="@color/preview_text" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU 81%" android:textColor="@color/preview_text_muted" android:textSize="10sp" />
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="81" android:progressTint="@color/preview_high" android:progressBackgroundTint="@color/preview_track" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mem 62%" android:textColor="@color/preview_text_muted" android:textSize="10sp" />
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="62" android:progressTint="@color/preview_ok" android:progressBackgroundTint="@color/preview_track" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="worker-2" android:textColor="@color/preview_text" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CPU 35%" android:textColor="@color/preview_text_muted" android:textSize="10sp" />
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="35" android:progressTint="@color/preview_ok" android:progressBackgroundTint="@color/preview_track" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mem 48%" android:textColor="@color/preview_text_muted" android:textSize="10sp" />
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:max="100" android:progress="48" android:progressTint="@color/preview_ok" android:progressBackgroundTint="@color/preview_track" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
