{
  "name": "dashboards",
  "version": "0.1.0",
  "license": "MIT",
  "headlamp": {
    "extraDist": {
      "LICENSE": "../../LICENSE"
    }
  },
  "description": "Headlamp plugin: build, save and view dashboards of widgets (tables, charts, clocks, notes) in tabs and sections, stored as ConfigMaps",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "storybook": "headlamp-plugin storybook",
    "storybook-build": "headlamp-plugin storybook-build",
    "test": "headlamp-plugin test",
    "i18n": "headlamp-plugin i18n"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "kubernetes-ui",
    "dashboards",
    "plugins"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "5.6.2"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@kinvolk/headlamp-plugin": "^0.14.0",
    "@types/react-grid-layout": "^1.3.5"
  },
  "dependencies": {
    "react-grid-layout": "^1.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
